#include <stdio.h>

int main() {
    int numeros[5];


    for (int i = 0; i < 5; i++) {
        printf("Ingresa un valor para numeros[%d]: ", i);
        scanf("%d", &numeros[i]);
    }


    printf("\nContenido del arreglo:\n");
    for (int i = 0; i < 5; i++) {
        printf("numeros[%d] = %d  (direccion: %lu)\n", i, numeros[i], (unsigned long)&numeros[i]);
    }

    return 0;
}
