#include <stdio.h>

void capturar(int m[3][3]);
void mostrar(int m[3][3]);
void Diagonal(int m[3][3]);
void guardarArchivo(int m[3][3]);
void leerArchivo(int m[3][3]);

void capturar(int m[3][3]) {
    int i, j;
    printf("=== Captura de la matriz 3x3 ===\n");
    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("Elemento [%d][%d]: ", i, j);
            scanf("%d", &m[i][j]);
        }
    }
}
void mostrar(int m[3][3]) {
    int i, j;
    printf("\n=== Matriz capturada ===\n");
    for (i = 0; i < 3; i++) {
        printf("| ");
        for (j = 0; j < 3; j++) {
            printf("%4d ", m[i][j]);
        }
        printf("|\n");
    }
}
void Diagonal(int m[3][3]) {
    int i, suma = 0;
    for (i = 0; i < 3; i++) {
        suma += m[i][i];
    }
    printf("\nSuma diagonal principal: %d\n", suma);
}
void guardarArchivo(int m[3][3]) {
    int i, j;
    FILE *fp;

    fp = fopen("matriz.txt", "w");

    if (fp == NULL) {
        printf("Error: no se pudo abrir el archivo.\n");
        return;
    }

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            fprintf(fp, "%d ", m[i][j]);
        }
        fprintf(fp, "\n");
    }

    fclose(fp);
    printf("\nMatriz guardada en 'matriz.txt' correctamente.\n");
}
void leerArchivo(int m[3][3]) {
    int i, j;
    FILE *fp;

    fp = fopen("matriz.txt", "r"); // "r" solo lectura

    if (fp == NULL) {
        printf("Error: no se encontro el archivo.\n");
        return;
    }

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            fscanf(fp, "%d", &m[i][j]); 
        }
    }

    fclose(fp);
    printf("Archivo leido correctamente.\n");
}


int main() {
    int matriz[3][3];
    int opcion;

    capturar(matriz);
    mostrar(matriz);
    Diagonal(matriz);
    guardarArchivo(matriz);

    printf("\n--- Leyendo matriz desde el archivo ---\n");
    leerArchivo(matriz);
    mostrar(matriz);

    return 0;
}

